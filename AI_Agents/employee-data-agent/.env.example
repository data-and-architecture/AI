DATABASE_URL=postgresql://postgres:password@localhost:5432/hr_database
# Must use a SQL Server login granted SELECT only on the registered database.
SQLSERVER_HR_DATABASE_URL=mssql+pyodbc://readonly_user:password@server/hr_sqlserver?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Optional OpenTelemetry collector endpoint, for example http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
OPENAI_API_KEY=your_api_key_here
